# Copy to .env (gitignored) or export these variables yourself.
# Env file: python -m tokensfree --env-file .env
# Real environment variables always win over the file.

# Local gateway token (32-128 chars [A-Za-z0-9_-]); required for /v1 and /api/profile management.
TOKENSFREE_LOCAL_TOKEN=
# Master switch for real upstream calls (profiles/real mode); keep 0 for mock.
TOKENSFREE_ENABLE_REAL=0
# Allow user-declared paid channels (default off).
TOKENSFREE_ALLOW_USER_PAID=0
